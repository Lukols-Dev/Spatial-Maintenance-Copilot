# Settings of the perception service, read by src/smc_perception/config.py.
# Copy to services/perception/.env (git ignores it) and give every variable a
# value: the service does not start without them, and names the ones missing.

# The agent's model on Amazon Bedrock, in a region with access to it: Amazon
# Nova through the Converse API, or an anthropic.… id for Claude through the
# Messages API. In eu-north-1 Nova 2 Lite runs only through the eu. profile.
SMC_BEDROCK_REGION=
SMC_AGENT_MODEL=eu.amazon.nova-2-lite-v1:0
SMC_AGENT_EFFORT=low

# How the service signs its calls to Bedrock: keys, the IAM user's keys below;
# on AWS role, the ECS task role, and the two keys are then left out.
SMC_AWS_AUTH=keys

# The keys of an IAM user allowed to invoke the model
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
