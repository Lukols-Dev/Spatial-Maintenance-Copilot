# ============================================================
# Secrets and credentials
# ============================================================
.env
.env.*
!.env.example
*.pem
*.key
credentials
.aws/

# ============================================================
# Capture data
# Media stays private and is referenced from
# eval/datasets/<name>/manifest.json by path and SHA-256, never committed.
# ============================================================
/data/
*.mp4
*.mov
*.MOV
*.avi
*.mkv
*.mts
# ...but in the web app .mts is TypeScript (an ES module), not AVCHD video.
!apps/web/**/*.mts
*.cr2
*.CR2
*.cr3
*.arw
*.nef
*.raf
*.dng

# ============================================================
# Python
# ============================================================
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ============================================================
# Node
# ============================================================
node_modules/
dist/
build/
.next/
out/

# ============================================================
# Infrastructure
# ============================================================
cdk.out/
# CDK's lookups for a deployment, keyed by the AWS account's number.
cdk.context.json
.terraform/
*.tfstate
*.tfstate.backup

# ============================================================
# OS and editors
# ============================================================
.DS_Store
Thumbs.db
.idea/
.vscode/
